# Public Environment Variables (Browser & Server)
# Safe for client bundles because of Supabase RLS and design
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjS5Snfyzj0OgTWGainTXuYIFFPr954WaZE6E

# Server-Only Environment Variables (Node.js runtime only)
