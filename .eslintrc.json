{
  "extends": ["next/core-web-vitals"],
  "rules": {
    "@typescript-eslint/no-explicit-any": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@/lib/supabase/service", "**/supabase/service*"],
            "message": "Security Rule DEC-12: service.ts can only be imported by outbox processing, push registration, staff-account creation, or purge."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/app/api/admin/staff/**",
        "src/app/api/public/tokens/**/push/**",
        "src/app/api/internal/purge/**",
        "src/features/notifications/**",
        "src/features/purge/**",
        "scripts/**",
        "tests/**"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
